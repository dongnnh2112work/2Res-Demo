# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only: used by /api/trigger to update event_state (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Secret path segment for LED control page: /display/<DISPLAY_SECRET>
DISPLAY_SECRET=change-me-to-a-long-random-string
