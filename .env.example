# Supabase (required on Vercel — without these the LED flickers 0↔N wishes)
# URL must be https://xxxx.supabase.co  (NO /rest/v1/ suffix, NO "placeholder")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only: used by /api/trigger to update event_state (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Secret path segment for LED control page: /display/<DISPLAY_SECRET>
DISPLAY_SECRET=change-me-to-a-long-random-string

# Optional: force in-memory store on localhost only (never enable on Vercel)
# USE_LOCAL_STORE=true
# NEXT_PUBLIC_USE_LOCAL_STORE=true
